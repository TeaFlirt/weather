APP_NAME=Weather
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8083

# База данных (внутри Docker сети)
DB_CONNECTION=pgsql
DB_HOST=weather-postgres
DB_PORT=5432
DB_DATABASE=weather_db
DB_USERNAME=weather_user
DB_PASSWORD=weather_password

# Vite
VITE_HOST=0.0.0.0
VITE_PORT=5173

# Кэш
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync